# Facebook / Meta Graph API
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# User token with ads_read — required for listing accounts and insights
FACEBOOK_ACCESS_TOKEN=

# Default ad account — numeric ID only, without act_ prefix
FACEBOOK_AD_ACCOUNT_ID=

# Optional: gate OAuth authorize step (Cloud Run / Claude connectors)
# MCP_OAUTH_PASSWORD=

# Set automatically by deploy-cloudrun.ps1 on Cloud Run (do not set locally)
# MCP_PUBLIC_URL=https://meta-mcp-xxxxx-uc.a.run.app

# Optional: where Claude OAuth clients/tokens are persisted so reconnects stay
# connected across process restarts (Cloud Run default: /tmp/meta-mcp-oauth-state.json)
# MCP_OAUTH_STATE_PATH=/tmp/meta-mcp-oauth-state.json
